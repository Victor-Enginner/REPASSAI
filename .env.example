# REPASS AI - Frontend (Vite)
# Copie para .env.local e ajuste. Variáveis VITE_* vão para o bundle
# público: NUNCA coloque chave secreta aqui.

# URL do backend REPASS AI (sem barra no final).
# Em produção aponte para o domínio real do backend.
VITE_API_BASE="http://localhost:8000"
# (o frontend roda em http://localhost:3000 — porta definida no vite.config.js)

# Domínio de publicação dos sites gerados.
# Deixe vazio enquanto o motor de deploy (Sprint 4) não existir — com
# valor vazio a UI não exibe nem envia link público.
VITE_DEPLOY_DOMAIN=""
