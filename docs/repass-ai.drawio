        <mxCell id="p0" value="ENTRADA&#10;lead do Google Places&#10;(nome, categoria, cidade, telefone)" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
