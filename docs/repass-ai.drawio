        <mxCell id="p1" value="CAMADA 1 · PREPARER&#10;template_preparer.py&#10;&#10;HTML cru → HTML + textos.json&#10;cada trecho ganha uma POSIÇÃO" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="CAMADA 2 · TRANSLATOR&#10;template_translator.py&#10;&#10;textos.json → plano.json → pt.html&#10;935 trechos · nenhum perdido" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="210" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="CAMADA 3 · COMPILER&#10;template_compiler.py&#10;&#10;pt.html + lead → generated_*.html&#10;troca por posição, não por frase" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="210" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="CAMADA 4 · AUDITOR&#10;template_auditor.py&#10;&#10;8 regras · sobrou francês? telefone&#10;de terceiro? imagem quebrada?" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="910" y="210" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="CAMADA 5 · STORE&#10;templates_store.py + R2&#10;&#10;persiste, versiona, publica&#10;_slug_seguro() na escrita" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="210" width="250" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="pfail" value="REPROVADO → site NÃO é entregue&#10;o auditor é a última porta antes do cliente ver" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="380" width="250" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="pw" value="POR QUE POSIÇÃO E NÃO FRASE&#10;&#10;Trocar por frase (&quot;Bienvenue&quot; → &quot;Bem-vindo&quot;) quebra quando a mesma frase aparece em dois&#10;contextos diferentes, e falha silenciosamente quando o template muda uma vírgula.&#10;Trocar por POSIÇÃO (índice do nó no DOM) é determinístico: ou o trecho existe naquela posição,&#10;ou o preparer acusa. É o que garante &quot;935 trechos, nenhum perdido&quot; como fato verificável." style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="820" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="pd" value="TRÊS DESTINOS DE CADA TRECHO&#10;&#10;1 · TRADUZIR — texto genérico do template (&quot;Nos services&quot;)&#10;2 · SUBSTITUIR — dado do lead (nome, telefone, cidade, categoria)&#10;3 · REMOVER — conteúdo da agência original que não pode vazar para o cliente" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="910" y="500" width="540" height="150" as="geometry"/>
        </mxCell>

