        <mxCell id="st" value="Auditoria de segurança — o que foi VERIFICADO no código, não presumido" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="sok" value="JÁ FECHADO — verificado nesta auditoria" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="480" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="sok1" value="✔ Zero segredo hardcoded&#10;grep de 8 padrões (sk-, gsk_, AIza, eyJ, ghp_, xoxb-,&#10;sk_live_, lin_api_) → só placeholders em docs/scripts" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sok">
          <mxGeometry x="15" y="40" width="450" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sok2" value="✔ .gitignore cobre variantes&#10;.env, .env.*, backend/.env.* — só .env.example rastreado&#10;git ls-files confirma: nenhum segredo versionado" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sok">
          <mxGeometry x="15" y="105" width="450" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sok3" value="✔ Headers — respostas JSON&#10;nosniff · X-Frame-Options DENY · CSP default-src 'none'&#10;· frame-ancestors 'none' · HSTS · Referrer-Policy&#10;(o preview HTML tem CSP próprio, mais permissivo — ver ao lado)" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sok">
          <mxGeometry x="15" y="170" width="450" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sok4" value="✔ CORS por allowlist, não '*'&#10;ORIGENS_PERMITIDAS + Vary: Origin&#10;Allow-Credentials só para origem conhecida" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sok">
          <mxGeometry x="15" y="235" width="450" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sok5" value="✔ SSRF no proxy de mídia&#10;HOSTS_PERMITIDOS: 4 hosts fixos&#10;→ 169.254.169.254 e localhost inalcançáveis" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sok">
          <mxGeometry x="15" y="300" width="450" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sok6" value="✔ Prompt injection via system role&#10;SYSTEM_PROMPTS fixos no servidor; cliente só escolhe&#10;`modo`. Nenhum caminho aceita instrução de sistema." style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sok">
          <mxGeometry x="15" y="365" width="450" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sok7" value="✔ XSS no frontend — nenhum sink&#10;0 ocorrências de dangerouslySetInnerHTML, innerHTML=,&#10;eval(), new Function(), document.write em src/" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sok">
          <mxGeometry x="15" y="400" width="450" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="sfix" value="CORRIGIDO NESTA SESSÃO" style="swimlane;html=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="480" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="sfix1" value="ALTO · Path traversal em templates_store.py&#10;&#10;extrair_slug() devolvia texto arbitrário no fallback.&#10;caminho_html/caminho_ficha faziam os.path.join direto.&#10;Alcançável por HTTP em 4 rotas:&#10;  POST /api/templates/import  → ESCRITA arbitrária&#10;  GET  /api/templates/detail  → LEITURA arbitrária&#10;  GET  /api/templates/preview → LEITURA arbitrária&#10;  GET  /api/templates/zip     → LEITURA arbitrária&#10;&#10;Correção: _slug_seguro() — basename + allowlist&#10;[a-zA-Z0-9._-] + rejeita vazio/só-pontuação.&#10;Provado com 7 payloads: todos contidos.&#10;29 testes existentes seguem passando." style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="sfix">
          <mxGeometry x="15" y="40" width="450" height="175" as="geometry"/>
        </mxCell>

        <mxCell id="sopen" value="FASE 1 EXECUTADA — 42 testes verdes (eram 29)" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="340" width="480" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="so1" value="✔ 1 · Denial of Wallet — NÃO era a RPC&#10;A RPC atômica já existia e estava certa. O furo era a&#10;ORDEM: trabalho caro rodava ANTES do débito, e o retorno&#10;era descartado. Agora debita antes e o retorno manda.&#10;Prova: 10 threads, cota 1 → Places chamado 1x." style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sopen">
          <mxGeometry x="15" y="40" width="450" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="so2" value="✔ 2 · Spoofing de X-Forwarded-For&#10;_ip_de_origem(): header só vale se PROXY_HEADER_IP&#10;declarar qual confiar; senão, IP do socket.&#10;Prova: 40 headers rotativos → 1 identidade, 31º recusado." style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sopen">
          <mxGeometry x="15" y="122" width="450" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="so3" value="✔ 3 · SSRF — o vetor descrito NÃO existia&#10;scraper_monster não busca URL do usuário; /site/clone só&#10;lê o domínio. Furo real: urlopen seguia redirect sem&#10;revalidar. Corrigido com RedirecionamentoRestrito." style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sopen">
          <mxGeometry x="15" y="194" width="450" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="so4" value="✔ 4 · Login neutro · ⚠ cadastro ainda enumera (produto)" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="sopen">
          <mxGeometry x="15" y="266" width="450" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="ssc" value="SUPPLY CHAIN&#10;&#10;npm audit — JÁ RODADO em 04/08/2026: 0 vulnerabilidades (runtime e dev).&#10;pip-audit + bandit + semgrep (offline, sem conta) · Snyk Code (requer conta) · Dependabot&#10;urlhaus.abuse.ch → feed de IOC para recusar domínio malicioso antes de buscar&#10;Elastic → índice central de log; hoje o log é fila em RAM (500) e some ao reiniciar" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1000" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="sgap" value="LACUNA REAL — TRÊS ROTAS CARAS SEM COTA NENHUMA&#10;&#10;/api/ai/generate    → chama llm_gateway.gerar()  · custo de LLM por chamada&#10;/api/site/generate  → HybridSiteGenerator        · custo de LLM por chamada&#10;/api/site/clone     → Lib77Engine                 · custo de geração&#10;&#10;As três exigem login e passam pelo rate limit (30/min), mas NÃO consomem cota de plano.&#10;30/min sustentado = 43.200 chamadas de LLM por dia, por usuário, em qualquer plano.&#10;A cota de site só é cobrada ao SALVAR — gerar sem salvar é ilimitado e de graça.&#10;&#10;Não corrigido: definir o que cada plano permite é decisão de negócio, não de engenharia." style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="590" width="700" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- PAGINA 4 - PLANO DE EXECUCAO                                 -->
  <!-- ============================================================ -->
  <diagram id="plano" name="4 · Plano de execução">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="xt" value="Plano de execução — ordem por RISCO, não por facilidade" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="f0" value="FASE 0 · FEITO&#10;&#10;· Auditoria de segredos (0 achados)&#10;· Path traversal fechado&#10;· 1.038 linhas de doc recuperadas&#10;· 29 testes verdes&#10;&#10;Impacto: superfície de escrita&#10;arbitrária em disco eliminada." style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="f1" value="FASE 1 · DINHEIRO&#10;&#10;· Cota atômica (FOR UPDATE)&#10;· CF-Connecting-IP no rate limit&#10;· Filtro anti-SSRF no scraper&#10;&#10;Impacto: fecha Denial of Wallet.&#10;É o único grupo onde a falha&#10;custa dinheiro real, por isso&#10;vem primeiro.&#10;&#10;Dep: nenhuma nova." style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="260" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="f2" value="FASE 2 · SUPPLY CHAIN&#10;&#10;· pip-audit + bandit&#10;· npm audit --omit=dev&#10;· semgrep --config=auto&#10;· CI no .github/workflows&#10;&#10;Impacto: qualquer dependência&#10;vulnerável passa a quebrar o&#10;build em vez de chegar em prod.&#10;&#10;Dep: 3 dev-only, offline." style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="260" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="f3" value="FASE 3 · OBSERVABILIDADE&#10;&#10;· Elastic / OpenSearch&#10;· log estruturado JSON&#10;· feed urlhaus como IOC&#10;&#10;Impacto: hoje o log vive em RAM&#10;(LOG_QUEUE 500) e some ao&#10;reiniciar — não há como&#10;investigar incidente passado.&#10;&#10;Dep: elasticsearch-py." style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="80" width="260" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="f4" value="FASE 4 · PRODUTO&#10;&#10;· verificação visual real&#10;· mídia do cliente&#10;· domínio próprio&#10;· acabamento e i18n&#10;&#10;Impacto: é o roadmap que já&#10;existe. Só entra depois que a&#10;base não sangra mais.&#10;&#10;Dep: a definir por item." style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="80" width="260" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="xr" value="REGRA QUE ORDENA TUDO&#10;&#10;Primeiro o que perde dinheiro (cota, IA, Places são custo por chamada).&#10;Depois o que perde confiança (vazamento, site sujo entregue ao cliente).&#10;Depois o que perde tempo (retrabalho, doc errada, build lento).&#10;Por último o que perde beleza.&#10;&#10;Nenhuma fase começa antes da anterior ter teste que prove que fechou." style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="700" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="xp" value="O QUE O REPASS AI É, EM TERMOS DE MODELO&#10;&#10;SaaS — é o que o cliente compra. Ele entra no painel, roda varredura, gera site.&#10;                Não instala nada, não gerencia servidor. 14 telas, cota por plano.&#10;&#10;PaaS — é o que o REPASS AI É POR DENTRO, e é a parte reaproveitável: o pipeline de&#10;                5 camadas + a loja de templates + os 1.140 componentes no R2 formam uma&#10;                plataforma de geração que outro produto poderia consumir por API.&#10;&#10;IaaS — NÃO é. Você consome IaaS de terceiros (R2, Supabase, Groq/Gemini/OpenRouter).&#10;                Não vende GPU nem máquina. É o contrário da Re-AI nesse eixo.&#10;&#10;A pilha da Re-AI (IaaS→PaaS→MaaS) descreve quem VENDE infraestrutura de IA.&#10;O REPASS AI senta na camada de cima dela: é consumidor de MaaS, produtor de SaaS." style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="370" width="720" height="330" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
