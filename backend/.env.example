# ------------------------------------------------------------
# 1) MOTORES DE IA â€” todos com camada gratuita
#    Preencha ao menos UM. A ordem de uso Ã© a de baixo, por prioridade.
# ------------------------------------------------------------

# --- Groq (prioridade 1) -------------------------------------
# Menor latÃªncia do mercado (chips LPU). Cota grÃ¡tis alta.
# Pegue em: https://console.groq.com/keys
GROQ_API_KEYS=
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Google AI Studio (prioridade 2) -------------------------
# Chave nativa Ã© gratuita: 15 req/min e 1.500 req/dia.
# Pegue em: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEYS=
GEMINI_MODEL="gemini-2.0-flash"

# --- OpenRouter (prioridade 3) -------------------------------
# Agrega vÃ¡rios modelos :free em uma Ãºnica chave.
# Pegue em: https://openrouter.ai/keys
OPENROUTER_API_KEYS=
# ATENÃ‡ÃƒO: a lista de modelos :free do OpenRouter muda com frequÃªncia.
# Confira em https://openrouter.ai/models?max_price=0 antes de fixar um.
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"

# --- Mistral / Codestral (prioridade 4) ----------------------
# Opcional. Aceita mÃºltiplas chaves separadas por vÃ­rgula.
MISTRAL_API_KEYS=
MISTRAL_MODEL="codestral-latest"

# --- Ollama local (prioridade 5, rede de seguranÃ§a) ----------
# Custo zero, sem limite, funciona offline. NÃ£o precisa de chave.
# O padrÃ£o 1.5B prioriza velocidade em CPU; troque para um coder maior se
# houver RAM e latÃªncia aceitÃ¡veis.
OLLAMA_URL="http://localhost:11434/api/generate"
OLLAMA_MODEL="qwen2.5:1.5b"


# ------------------------------------------------------------
# 2) FONTE DE LEADS REAIS
#    Sem esta chave o scanner fica em MODO DEMO (telefone nulo,
#    disparo comercial bloqueado).
# ------------------------------------------------------------

# Google Cloud â†’ ative "Places API" â†’ restrinja a chave por IP.
# CUSTO: ~US$ 17 / 1.000 chamadas. Cada lead consome 2 chamadas
# (Text Search + Details). Varredura de 40 leads â‰ˆ US$ 1,40.
# Configure billing alerts antes de abrir para clientes.
GOOGLE_PLACES_API_KEY=""


# ------------------------------------------------------------
# 3) BANCO DE DADOS E LOGIN (Supabase) â€” OPCIONAL
#
#    DEIXE VAZIO e o app roda como hoje: single-user, sem login,
#    dados no navegador. Preencha para ligar o modo multiusuÃ¡rio.
#
#    Antes de preencher, rode `supabase/schema.sql` no SQL Editor
