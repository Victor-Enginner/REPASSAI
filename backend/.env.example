# ------------------------------------------------------------

# Painel Supabase -> Project Settings -> API
SUPABASE_URL=""

# Projetos novos: chave `sb_publishable_...`.
# Ã‰ pÃºblica por natureza e vai ao navegador para fazer login.
SUPABASE_PUBLISHABLE_KEY=""

# Projetos novos: chave `sb_secret_...`. SEGREDO ABSOLUTO.
# SÃ³ o backend usa. Nunca coloque em variÃ¡vel VITE_* ou NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=""

# Compatibilidade com projetos Supabase antigos. Preencha estes campos apenas
