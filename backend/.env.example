# ============================================================
# REPASS AI — Backend
# Copie para backend/.env e cole suas chaves. O .env está no .gitignore.
#
# TODAS as chaves de IA ficam aqui, no servidor. O frontend nunca as vê,
# nem sabe qual modelo está rodando por trás.
#
# ROTAÇÃO: cada variável de chave aceita VÁRIAS chaves separadas por
# vírgula. O gateway faz rodízio entre elas e, ao tomar 429, coloca a
# chave em descanso por 60s e segue para a próxima automaticamente.
#   Exemplo:  GROQ_API_KEYS="gsk_aaa,gsk_bbb,gsk_ccc"
# ============================================================


# ------------------------------------------------------------
# 1) MOTORES DE IA — todos com camada gratuita
#    Preencha ao menos UM. A ordem de uso é a de baixo, por prioridade.
# ------------------------------------------------------------

# --- Groq (prioridade 1) -------------------------------------
# Menor latência do mercado (chips LPU). Cota grátis alta.
# Pegue em: https://console.groq.com/keys
GROQ_API_KEYS=""
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Google AI Studio (prioridade 2) -------------------------
# Chave nativa é gratuita: 15 req/min e 1.500 req/dia.
# Pegue em: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEYS=""
GEMINI_MODEL="gemini-2.0-flash"

# --- OpenRouter (prioridade 3) -------------------------------
# Agrega vários modelos :free em uma única chave.
# Pegue em: https://openrouter.ai/keys
OPENROUTER_API_KEYS=""
# ATENÇÃO: a lista de modelos :free do OpenRouter muda com frequência.
# Confira em https://openrouter.ai/models?max_price=0 antes de fixar um.
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"

# --- Ollama local (prioridade 4, rede de segurança) ----------
# Custo zero, sem limite, funciona offline. Não precisa de chave.
# Instale em https://ollama.com e rode: ollama pull qwen2.5-coder
OLLAMA_URL="http://localhost:11434/api/generate"
OLLAMA_MODEL="qwen2.5-coder"


# ------------------------------------------------------------
# 2) FONTE DE LEADS REAIS
#    Sem esta chave o scanner fica em MODO DEMO (telefone nulo,
#    disparo comercial bloqueado).
# ------------------------------------------------------------

# Google Cloud → ative "Places API" → restrinja a chave por IP.
# CUSTO: ~US$ 17 / 1.000 chamadas. Cada lead consome 2 chamadas
# (Text Search + Details). Varredura de 40 leads ≈ US$ 1,40.
# Configure billing alerts antes de abrir para clientes.
GOOGLE_PLACES_API_KEY=""


# ------------------------------------------------------------
# 3) BANCO DE DADOS E LOGIN (Supabase) — OPCIONAL
#
#    DEIXE VAZIO e o app roda como hoje: single-user, sem login,
#    dados no navegador. Preencha para ligar o modo multiusuário.
#
#    Antes de preencher, rode `supabase/schema.sql` no SQL Editor
#    do projeto. Passo a passo em docs/GUIA_SUPABASE.md.
# ------------------------------------------------------------

# Painel Supabase -> Project Settings -> API
SUPABASE_URL=""

# Chave "anon public". É pública por natureza — vai para o navegador
# fazer login. O RLS bloqueia acesso direto ao banco com ela.
SUPABASE_ANON_KEY=""

# Chave "service_role". SEGREDO ABSOLUTO: ignora RLS e lê tudo.
# Só o backend usa. Nunca coloque em variável VITE_*.
SUPABASE_SERVICE_ROLE_KEY=""


# ------------------------------------------------------------
# 4) REDE E AMBIENTE
# ------------------------------------------------------------

# URL pública deste backend. Entra nos links do proxy de mídia
# gravados em cada lead — se ficar errado, as imagens quebram em produção.
PUBLIC_BASE_URL="http://localhost:8000"

# Origens autorizadas a chamar a API pelo navegador (CORS).
# Em produção, troque pelo domínio real do frontend.
CORS_ORIGINS="http://localhost:3000,http://localhost:4173"


# ------------------------------------------------------------
# 4) IDENTIDADE NA ABORDAGEM COMERCIAL
#    Entram na mensagem: "Sou o {NOME}, da {MARCA}, e ajudo..."
#    Se ficarem vazios, a mensagem usa uma forma neutra.
# ------------------------------------------------------------

REPASS_OPERADOR_NOME=""
REPASS_OPERADOR_MARCA=""


# ------------------------------------------------------------
# 5) OPCIONAL — execução serverless da varredura
# ------------------------------------------------------------

MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""
