  },
  {
    "id": 52,
    "tag": "p",
    "texto": "Vom Fundament bis zur Decke: Wir verlegen Betonstahl exakt nach Bewehrungsplan – für Bauunternehmen, Generalunternehmer und Projektleiter, die sich auf ihren Nachunternehmer verlassen müssen.",
    "inicio": 25937,
    "fim": 26128
  },
  {
    "id": 53,
    "tag": "h3",
    "texto": "Bodenplatten",
    "inicio": 27057,
    "fim": 27069
  },
  {
    "id": 54,
    "tag": "p",
    "texto": "Untere und obere Lage, Randeinfassungen, Zulagen – maßhaltig verlegt und sauber dokumentiert. Die Basis für jedes Bauwerk.",
    "inicio": 27143,
    "fim": 27265
  },
  {
    "id": 55,
    "tag": "h3",
    "texto": "Deckenbewehrung",
    "inicio": 28151,
    "fim": 28166
  },
  {
    "id": 56,
    "tag": "p",
    "texto": "Komplette Deckenbewehrung inklusive Durchstanzbewehrung, Abstandhaltern und Anschlüssen – termingerecht zur Betonage.",
    "inicio": 28240,
    "fim": 28357
  },
  {
    "id": 57,
    "tag": "h3",
    "texto": "Ortbetonwände",
    "inicio": 29245,
    "fim": 29258
  },
  {
    "id": 58,
    "tag": "p",
    "texto": "Wandbewehrung mit exakten Übergreifungen, Eckausbildungen und Aussparungen – passgenau für die Schalung.",
    "inicio": 29332,
    "fim": 29436
  },
  {
    "id": 59,
    "tag": "h3",
    "texto": "Ingenieurbau",
    "inicio": 30298,
    "fim": 30310
  },
  {
    "id": 60,
    "tag": "p",
    "texto": "Anspruchsvolle Bewehrung für Sonderbauwerke: hohe Bewehrungsgrade, komplexe Geometrien, präzise Ausführung.",
    "inicio": 30384,
    "fim": 30491
  },
  {
    "id": 61,
    "tag": "h3",
    "texto": "Industrie- & Gewerbebau",
    "inicio": 31380,
    "fim": 31407
  },
  {
    "id": 62,
    "tag": "p",
    "texto": "Großflächige Bewehrung für Hallen, Logistikzentren und Gewerbeobjekte – mit der Kapazität für enge Taktpläne.",
    "inicio": 31481,
    "fim": 31590
  },
  {
    "id": 63,
    "tag": "h3",
    "texto": "Nachunternehmerleistungen",
    "inicio": 32479,
    "fim": 32504
  },
  {
    "id": 64,
    "tag": "p",
    "texto": "Verlässlicher Partner für Bauunternehmen und GU: klare Kommunikation, saubere Schnittstellen, vertragstreue Abwicklung.",
    "inicio": 32578,
    "fim": 32697
  },
  {
    "id": 65,
    "tag": "h3",
    "texto": "Logistik-Management & Baustellen-Support",
    "inicio": 33678,
    "fim": 33722
  },
  {
    "id": 66,
    "tag": "p",
    "texto": "Materialkoordination, Stahlannahme, Lagerorganisation und Unterstützung im Bauablauf – damit Ihre Baustelle im Takt bleibt.",
    "inicio": 33806,
    "fim": 33929
  },
  {
    "id": 67,
    "tag": "a",
    "texto": "Anfrage stellen",
    "inicio": 34166,
    "fim": 34181
  },
  {
    "id": 68,
    "tag": "p",
    "texto": "Ausführung nach Bewehrungsplan",
    "inicio": 35959,
    "fim": 35989
  },
  {
    "id": 69,
    "tag": "?",
    "texto": "Warum KRANNIK BAU?",
    "inicio": 36239,
    "fim": 36257
  },
  {
    "id": 70,
    "tag": "h2",
    "texto": "Weil Ihre Betonage nicht warten kann.",
    "inicio": 36396,
    "fim": 36433
  },
  {
    "id": 71,
    "tag": "p",
    "texto": "Verzögerungen in der Bewehrung kosten Geld, Takt und Nerven. Wir sorgen dafür, dass Ihre Abnahme planmäßig läuft – mit eingespielten Teams und klarer Kommunikation.",
    "inicio": 36502,
    "fim": 36666
  },
  {
    "id": 72,
    "tag": "p",
    "texto": "Meistergeführte Kolonnen",
    "inicio": 37088,
    "fim": 37112
  },
  {
    "id": 73,
    "tag": "p",
    "texto": "Erfahrene Vorarbeiter mit Verantwortung – auch bei komplexen Bewehrungsgraden.",
    "inicio": 37187,
    "fim": 37265
  },
  {
    "id": 74,
    "tag": "p",
    "texto": "Termintreue",
    "inicio": 37713,
    "fim": 37724
  },
  {
    "id": 75,
    "tag": "p",
    "texto": "Wir halten Taktpläne ein – und melden uns frühzeitig, wenn etwas zu klären ist.",
    "inicio": 37799,
    "fim": 37878
  },
  {
    "id": 76,
    "tag": "p",
    "texto": "Saubere Ausführung nach Bewehrungsplan",
    "inicio": 38337,
    "fim": 38375
  },
  {
    "id": 77,
    "tag": "p",
    "texto": "Lagen, Übergreifungen, Abstände – exakt nach Statik. Abnahmebereit, ohne Nacharbeit.",
    "inicio": 38450,
    "fim": 38534
  },
  {
    "id": 78,
    "tag": "p",
    "texto": "Einsatz in NRW & Niedersachsen",
    "inicio": 38985,
    "fim": 39019
  },
  {
    "id": 79,
    "tag": "p",
    "texto": "Von Herford aus schnell auf Ihrer Baustelle – auch kurzfristig.",
