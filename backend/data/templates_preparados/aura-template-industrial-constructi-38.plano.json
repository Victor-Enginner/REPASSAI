    {
      "id": 52,
      "tag": "p",
      "original": "Vom Fundament bis zur Decke: Wir verlegen Betonstahl exakt nach Bewehrungsplan – für Bauunternehmen, Generalunternehmer und Projektleiter, die sich auf ihren Nachunternehmer verlassen müssen.",
      "destino": "adaptar",
      "texto": "Da fundação até o laço: posicionamos a armadura de concreto exatamente conforme o projeto – para construtoras, empreiteiras e engenheiros que precisam confiar no seu subcontratado."
    },
    {
      "id": 53,
      "tag": "h3",
      "original": "Bodenplatten",
      "destino": "traduzir",
      "texto": "Lajes de concreto"
    },
    {
      "id": 54,
      "tag": "p",
      "original": "Untere und obere Lage, Randeinfassungen, Zulagen – maßhaltig verlegt und sauber dokumentiert. Die Basis für jedes Bauwerk.",
      "destino": "adaptar",
      "texto": "Camada inferior e superior, bordas e sobreposições – posicionadas com precisão e bem documentadas. A base de toda obra."
    },
    {
      "id": 55,
      "tag": "h3",
      "original": "Deckenbewehrung",
      "destino": "traduzir",
      "texto": "Armadura de laje"
    },
    {
      "id": 56,
      "tag": "p",
      "original": "Komplette Deckenbewehrung inklusive Durchstanzbewehrung, Abstandhaltern und Anschlüssen – termingerecht zur Betonage.",
      "destino": "adaptar",
      "texto": "Armadura completa de laje, incluindo armadura contra punção, espaçadores e conexões – entregue no prazo para o concreto."
    },
    {
      "id": 57,
      "tag": "h3",
      "original": "Ortbetonwände",
      "destino": "traduzir",
      "texto": "Muros de concreto armado"
    },
    {
      "id": 58,
      "tag": "p",
      "original": "Wandbewehrung mit exakten Übergreifungen, Eckausbildungen und Aussparungen – passgenau für die Schalung.",
      "destino": "adaptar",
      "texto": "Armadura de muro com sobreposições exatas, detalhes de cantos e aberturas – ajustada perfeitamente para a forma."
    },
    {
      "id": 59,
      "tag": "h3",
      "original": "Ingenieurbau",
      "destino": "traduzir",
      "texto": "Obras de engenharia"
    },
    {
      "id": 60,
      "tag": "p",
      "original": "Anspruchsvolle Bewehrung für Sonderbauwerke: hohe Bewehrungsgrade, komplexe Geometrien, präzise Ausführung.",
      "destino": "adaptar",
      "texto": "Armadura exigente para obras especiais: alta taxa de armadura, geometrias complexas, execução precisa."
    },
    {
      "id": 61,
      "tag": "h3",
      "original": "Industrie- & Gewerbebau",
      "destino": "traduzir",
      "texto": "Construção industrial e comercial"
    },
    {
      "id": 62,
      "tag": "p",
      "original": "Großflächige Bewehrung für Hallen, Logistikzentren und Gewerbeobjekte – mit der Kapazität für enge Taktpläne.",
      "destino": "adaptar",
      "texto": "Armadura em larga escala para galpões, centros logísticos e prédios comerciais – com capacidade para cronogramas apertados."
    },
    {
      "id": 63,
      "tag": "h3",
      "original": "Nachunternehmerleistungen",
      "destino": "traduzir",
      "texto": "Serviços de subcontratado"
    },
    {
      "id": 64,
      "tag": "p",
      "original": "Verlässlicher Partner für Bauunternehmen und GU: klare Kommunikation, saubere Schnittstellen, vertragstreue Abwicklung.",
      "destino": "adaptar",
      "texto": "Parceiro confiável para construtoras e empreiteiras: comunicação clara, interfaces bem definidas e execução conforme contrato."
    },
    {
      "id": 65,
      "tag": "h3",
      "original": "Logistik-Management & Baustellen-Support",
      "destino": "traduzir",
      "texto": "Gestão de logística e suporte de obra"
    },
    {
      "id": 66,
      "tag": "p",
      "original": "Materialkoordination, Stahlannahme, Lagerorganisation und Unterstützung im Bauablauf – damit Ihre Baustelle im Takt bleibt.",
      "destino": "adaptar",
      "texto": "Coordenação de materiais, recebimento de aço, organização do estoque e apoio no processo construtivo – para que sua obra continue no ritmo."
    },
    {
      "id": 67,
      "tag": "a",
      "original": "Anfrage stellen",
      "destino": "traduzir",
      "texto": "Solicitar orçamento"
    },
    {
      "id": 68,
      "tag": "p",
      "original": "Ausführung nach Bewehrungsplan",
      "destino": "traduzir",
      "texto": "Execução conforme o plano de armadura"
    },
    {
      "id": 69,
      "tag": "?",
      "original": "Warum KRANNIK BAU?",
      "destino": "traduzir",
      "texto": "Por que KRANNIK BAU?"
    },
    {
      "id": 70,
      "tag": "h2",
      "original": "Weil Ihre Betonage nicht warten kann.",
      "destino": "traduzir",
      "texto": "Porque sua concretagem não pode esperar."
    },
    {
      "id": 71,
      "tag": "p",
      "original": "Verzögerungen in der Bewehrung kosten Geld, Takt und Nerven. Wir sorgen dafür, dass Ihre Abnahme planmäßig läuft – mit eingespielten Teams und klarer Kommunikation.",
      "destino": "adaptar",
      "texto": "Atrasos na armadura custam dinheiro, prazo e tranquilidade. Garantimos que sua aprovação ocorra no cronograma – com equipes experientes e comunicação clara."
    },
    {
      "id": 72,
      "tag": "p",
      "original": "Meistergeführte Kolonnen",
      "destino": "traduzir",
      "texto": "Equipes lideradas por mestres"
    },
    {
      "id": 73,
      "tag": "p",
      "original": "Erfahrene Vorarbeiter mit Verantwortung – auch bei komplexen Bewehrungsgraden.",
      "destino": "traduzir",
      "texto": "Capatazes experientes com responsabilidade – mesmo em armaduras complexas."
    },
    {
      "id": 74,
      "tag": "p",
      "original": "Termintreue",
      "destino": "traduzir",
      "texto": "Pontualidade"
    },
    {
      "id": 75,
      "tag": "p",
      "original": "Wir halten Taktpläne ein – und melden uns frühzeitig, wenn etwas zu klären ist.",
      "destino": "traduzir",
      "texto": "Cumprimos os cronogramas – e avisamos antecipadamente se algo precisar ser esclarecido."
    },
    {
      "id": 76,
      "tag": "p",
      "original": "Saubere Ausführung nach Bewehrungsplan",
      "destino": "traduzir",
      "texto": "Execução limpa conforme o plano de armadura."
    },
    {
      "id": 77,
      "tag": "p",
      "original": "Lagen, Übergreifungen, Abstände – exakt nach Statik. Abnahmebereit, ohne Nacharbeit.",
      "destino": "traduzir",
      "texto": "Sobreposições, emendas e espaçamentos – exatamente conforme a estática. Pronto para vistoria, sem retrabalho."
    },
